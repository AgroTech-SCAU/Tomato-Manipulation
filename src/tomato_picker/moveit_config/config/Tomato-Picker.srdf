<?xml version="1.0" encoding="UTF-8"?>
<robot name="Tomato-Picker">
  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>

  <!-- Separate kinematic group: accurate fixed TCP tip for hand-eye servo only -->
  <group name="handeye_tip">
    <chain base_link="base_link" tip_link="tip"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>

  <disable_collisions link1="base_link" link2="Link1" reason="Adjacent"/>
  <disable_collisions link1="Link1" link2="Link2" reason="Adjacent"/>
  <disable_collisions link1="Link2" link2="Link3" reason="Adjacent"/>
  <disable_collisions link1="Link3" link2="Link4" reason="Adjacent"/>
  <disable_collisions link1="Link4" link2="Link5" reason="Adjacent"/>
  <disable_collisions link1="Link5" link2="Link6" reason="Adjacent"/>

  <!-- The wrist housing carries the pinion and both sliding jaw/rack assemblies.
       Their mounting/guide contacts are internal to the gripper assembly. -->
  <disable_collisions link1="Link6" link2="Link7" reason="Adjacent"/>
  <disable_collisions link1="Link6" link2="Link7-1" reason="Adjacent"/>
  <disable_collisions link1="Link6" link2="Link7-2" reason="Adjacent"/>
  <!-- Pinion/rack tooth contact is part of the drive, not an arm collision. -->
  <disable_collisions link1="Link7" link2="Link7-1" reason="GripperTransmission"/>
  <disable_collisions link1="Link7" link2="Link7-2" reason="GripperTransmission"/>
</robot>
