<?xml version="1.0"?>
<package format="3">
  <name>tomato_picker_mujoco</name>
  <version>0.1.0</version>
  <description>MuJoCo contact-based harvesting and end-effector adapter for Tomato-Picker</description>
  <maintainer email="kaerei@foxmail.com">Kaede Rei</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>mujoco_ros2_control_plugins</depend>
  <depend>mujoco_vendor</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
